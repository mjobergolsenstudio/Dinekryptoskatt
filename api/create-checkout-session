// og legg denne filen inn der.

const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);

module.exports = async (req, res) => {
  // Tillat CORS
  res.setHeader('Access-Control-Allow-Origin', 'https://dinkryptoskatt.no');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  // Håndter preflight-request fra nettleseren
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  // Kun POST er tillatt
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { priceId } = req.body;

    // Sikkerhetssjekk – kun tillat ditt eget Price ID
    const tillattePriceIds = [
      process.env.STRIPE_PRICE_ID
    ];

    if (!tillattePriceIds.includes(priceId)) {
      return res.status(400).json({ error: 'Ugyldig produkt' });
    }

    // Opprett Stripe Checkout Session
    const session = await stripe.checkout.sessions.create({
      payment_method_types: ['card'],
      line_items: [
        {
          price: priceId,
          quantity: 1,
        },
      ],
      mode: 'payment',
      // Etter vellykket betaling – tilbake til appen med ?payment=success
      success_url: 'https://dinkryptoskatt.no/app.html?payment=success',
      // Hvis brukeren avbryter
      cancel_url: 'https://dinkryptoskatt.no/app.html',
      // Forhåndsutfyll e-post hvis tilgjengelig
      billing_address_collection: 'auto',
      // Metadata for å spore salg
      metadata: {
        produkt: 'DinKryptoskatt 2025',
        kilde: 'dinkryptoskatt.no'
      },
      // Norsk språk i checkout
      locale: 'nb',
    });

    return res.status(200).json({ url: session.url });

  } catch (error) {
    console.error('Stripe feil:', error.message);
    return res.status(500).json({ error: 'Betalingsfeil – prøv igjen' });
  }
};
